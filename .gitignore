# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mjgak: 수집한 대학 보고서 원문 PDF는 절대 커밋하지 않음 (재배포 금지)
/data/raw/
/pipeline/raw/
/pipeline/out/_*

# sqlite
*.db
*.db-journal
*.sqlite

# python
/pipeline/.venv/
__pycache__/
*.pyc

# 정적 사이트 산출물
/site/dist/

# 자동 감시 결과(실행 때마다 생성)
monitor/report.md
